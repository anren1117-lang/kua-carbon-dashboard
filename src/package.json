{
  "name": "kua-carbon-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run check:nul && vitest run",
    "test:watch": "vitest",
    "verify": "npm test && npm run build && npm run check:bundle",
    "check:nul": "cd .. && node scripts/check-no-nul-bytes.mjs",
    "check:bundle": "cd .. && node scripts/check-bundle-size.mjs",
    "verify:deploy": "cd .. && node scripts/verifyDeploy.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "katex": "^0.17.0",
    "pdfjs-dist": "^6.4.299",
    "pigeon-maps": "^0.22.1",
    "pptxgenjs": "^4.0.1",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-katex": "^3.1.0",
    "react-router-dom": "^6.15.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^15.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^23.0.0",
    "vite": "^5.4.0",
    "vitest": "^1.5.2"
  }
}
