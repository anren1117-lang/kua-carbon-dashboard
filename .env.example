# Copy to .env and fill in. Never commit the real .env.
# Vercel envs are set in the Vercel project dashboard, not here.

# === Anthropic API (used by /api/chat — the Ask agent) ===
ANTHROPIC_API_KEY=sk-ant-...

# === Supabase ===
# Public client envs (read by the React app under VITE_)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Server-side envs (read by /api handlers via SUPABASE_*). When BOTH are
# set, /api/quiz/attempts and the CSV adapter mirror writes to Supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# === Meter data source ===
# One of: mock | csv | utility_api | bms
# Defaults to mock if unset.
METER_SOURCE=mock
VITE_METER_SOURCE=mock

# === BMS (Distech Eclypse) ===
# Required when METER_SOURCE=bms.
# BMS_BASE_URL must be reachable from wherever the request runs:
#   - Local dev: https://10.1.1.27 (campus LAN)
#   - Vercel:    https://relay.kua.org (the on-campus relay's tunnel)
BMS_BASE_URL=https://10.1.1.27
BMS_USERNAME=
BMS_PASSWORD=
# JSON map: { "<meterId>": "<eclypse object path>" }
BMS_POINT_MAP={"m_elec_b_miller":"protocols/bacnet/local/objects/analog-value,5/present-value"}

# === Cron (used by /api/cron/sync-bms) ===
# Random string. Vercel cron invocations include this; manual calls must
# pass it as a Bearer token. Without it, the endpoint refuses every request.
CRON_SECRET=

# === Portal passwords (client-side gates only) ===
# These are SOFT gates rendered by the React app. They keep casual visitors
# out of /teacher and /admin but are NOT a real auth boundary — anyone who
# pulls the JS bundle can read these values. Real protection of sensitive
# operations happens server-side (CRON_SECRET, Google OIDC, etc.).
VITE_TEACHER_PASSWORD=kua-teach
VITE_ADMIN_PASSWORD=KUA2026

# === Auth (used by /api/auth/session) ===
# Comma-separated list of email domains allowed to mint a session
AUTH_ALLOWED_DOMAINS=kua.org,students.kua.org
# Google OAuth client ID for KUA. Tokens whose `aud` claim doesn't match are rejected.
AUTH_GOOGLE_AUDIENCE=
# Set to "1" only in dev. Allows POST /api/auth/session with { mockSubject } instead of a real ID token.
AUTH_DEV_MODE=

# === Relay only (relay/server.js) ===
# Port the relay listens on inside the campus network
PORT=3001
